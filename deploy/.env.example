# Copy to .env in the project root and fill in. Never commit .env — the repo is public.

# Domain Caddy serves and gets the certificate for.
# No domain yet? Use your server IP with dashes + .sslip.io, e.g. 141-147-12-34.sslip.io
DOMAIN=

# Public address of the app, https + DOMAIN, e.g. https://141-147-12-34.sslip.io
APP_URL=

# Telegram bot (@BotFather) — login from the Mini App, reminders, webhook
TELEGRAM_BOT_TOKEN=

# Google Gemini — photo and text recognition (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Resend — password reset emails (https://resend.com/api-keys)
RESEND_API_KEY=
MAIL_FROM=Nura <noreply@your-domain.uz>

# Admin endpoints (/api/admin/backup, /api/admin/stats), header X-Admin-Key. Any long random string.
ADMIN_KEY=
